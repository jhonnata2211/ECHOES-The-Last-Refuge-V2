[gd_scene load_steps=3 format=3]

; ECHOES-024: tela inicial provisória; sem lore ou assets artísticos novos.

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_main_menu"]
[ext_resource type="Script" path="res://scripts/ui/touch_menu_button.gd" id="2_menu_button"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.045, 0.04, 1)
metadata/placeholder = true

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Center" type="CenterContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2

[node name="Rows" type="VBoxContainer" parent="Margin/Center"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 40

[node name="Title" type="Label" parent="Margin/Center/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.86, 0.9, 0.84, 1)
theme_override_font_sizes/font_size = 42
text = "ECHOES: The Last Refuge"
horizontal_alignment = 1
autowrap_mode = 3

[node name="StartButton" type="Button" parent="Margin/Center/Rows"]
custom_minimum_size = Vector2(240, 72)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "INICIAR"
script = ExtResource("2_menu_button")

[connection signal="pressed" from="Margin/Center/Rows/StartButton" to="." method="_on_start_pressed"]
