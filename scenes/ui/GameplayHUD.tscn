[gd_scene load_steps=6 format=3]

; ECHOES-022: HUD provisório com estilos nativos, sem captura de input.

[ext_resource type="Script" path="res://scripts/ui/gameplay_hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.045, 0.06, 0.065, 0.85)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_background"]
bg_color = Color(0.12, 0.14, 0.15, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_health"]
bg_color = Color(0.68, 0.28, 0.26, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_stamina"]
bg_color = Color(0.48, 0.65, 0.38, 1)

[node name="GameplayHUD" type="CanvasLayer"]
layer = 2
script = ExtResource("1_hud")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 24.0
offset_top = 24.0
offset_right = 312.0
offset_bottom = 176.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="Rows" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="HealthLabel" type="Label" parent="Panel/Margin/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 18
text = "VIDA"

[node name="HealthBar" type="ProgressBar" parent="Panel/Margin/Rows"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_background")
theme_override_styles/fill = SubResource("StyleBoxFlat_health")
step = 0.0
show_percentage = false

[node name="StaminaLabel" type="Label" parent="Panel/Margin/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 18
text = "STAMINA"

[node name="StaminaBar" type="ProgressBar" parent="Panel/Margin/Rows"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_background")
theme_override_styles/fill = SubResource("StyleBoxFlat_stamina")
step = 0.0
show_percentage = false
