; Engine configuration file.
; Edit through the Godot project settings when possible.

config_version=5

[application]

config/name="ECHOES: The Last Refuge"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":87), Object(InputEventKey,"keycode":4194320)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":83), Object(InputEventKey,"keycode":4194322)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65), Object(InputEventKey,"keycode":4194319)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68), Object(InputEventKey,"keycode":4194321)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":69)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194325,"location":1)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
